*.blend2
*.blend3

# Python cache (Blender scripts)
__pycache__/
*.py[cod]

# Temporary renders & OS files
blender/renders/temp_render.png
blender/renders/test_*.png
blender/renders/test_*.json
blender/renders/scene_debug.json
.DS_Store
Thumbs.db
